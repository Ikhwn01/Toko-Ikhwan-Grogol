{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "includeFiles": [
        "**/*.php",
        "vendor/**",
        "config/**",
        "includes/**",
        "laporan/**",
        "proses/**",
        "assets/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
